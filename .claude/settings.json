{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .claude/hooks/lint-edited-file.py 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Linting edited file with oxlint..."
          }
        ]
      }
    ]
  }
}
